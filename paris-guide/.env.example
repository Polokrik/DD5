# Renseignez ces valeurs puis reportez-les dans app.json > expo.extra
# (ou chargez-les via app.config.ts si vous préférez les variables d'environnement)

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_KEY

# Identifiants partagés du binôme (room unique à 2 utilisateurs)
EXPO_PUBLIC_ROOM_ID=duo-paris
